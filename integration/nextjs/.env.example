# AVS configuration for the Next.js app.
#
# Copy to `.env.local`. That file is git-ignored by Next.js default; keep it
# that way — everything below is server-side configuration and one of these is
# a signing key.
#
# ⛔⛔ NEVER PREFIX ANY OF THESE WITH `NEXT_PUBLIC_`.
#
#    Next.js inlines every `NEXT_PUBLIC_*` variable into the JavaScript bundle
#    the browser downloads. That single prefix is the entire difference between
#    a server secret and a published one. `NEXT_PUBLIC_AVS_SECRET` would hand
#    every visitor the ability to submit Aadhaar jobs as your tenant.
#
#    These are read only by `lib/avsClient.ts`, which is marked `server-only`
#    so that importing it from a client component fails the BUILD rather than
#    leaking quietly.

# Where AVS is deployed.
# ⚠ HTTPS in production. Aadhaar images cross this link.
AVS_URL=http://127.0.0.1:8477

# Must match `tenant_id` in the AVS `tenants.json`. An identifier, not a secret.
AVS_TENANT_ID=m-one-prod

# ⛔ The HMAC signing key. Must be byte-identical to the value AVS holds for
#    this tenant, in `AVS_TENANT_M_ONE_PROD_SECRET`.
#
#    Generate it at deploy time, straight into your secret store:
#        openssl rand -hex 32
#
#    Never send it over chat, email, Slack or a ticket. If it has ever appeared
#    in a message, regenerate it — rotating is cheap, a leaked signing key is not.
#
#    Both services refuse to start on anything under 32 characters or containing
#    `changeme`/`secret`/`placeholder`. A service that silently starts with a
#    placeholder key is worse than one that refuses to, because nothing looks
#    wrong until it is exploited.
AVS_SECRET=

# The HRM database, where APPROVED verifications are recorded.
#
# Apply `migrations/001_aadhaar_verification.sql` before first use. It carries
# two CHECK constraints that nothing else enforces:
#   - VERIFIED requires signature_valid = TRUE  (CONTRACTS.md §1 Rule 1)
#   - aadhaar_last4 must be exactly four digits (never a full number)
#
# ⚠ If your HRM does not expose its database to this app, leave this unset and
#   replace the body of `saveVerification` in lib/verificationStore.ts with a
#   call to your internal API. That function is the only place that knows how
#   records are stored.
#
# Requires: npm install pg @types/pg
HRM_DATABASE_URL=
