# Copy to .env and adjust. Never commit .env.

AVS_ENVIRONMENT=development
AVS_LOG_LEVEL=INFO
AVS_LOG_JSON=false

# Step 2 — UIDAI certificate trust store
AVS_CERT_DIR=certs
AVS_CERT_EXPIRY_WARN_DAYS=90

# Step 3 — ingest limits
AVS_MAX_FILE_BYTES=20971520
AVS_MIN_FILE_BYTES=51200
AVS_ENABLE_MALWARE_SCAN=false

# Step 6 — privacy. MUST come from a vault in production.
AVS_REFERENCE_HASH_SECRET=CHANGE-ME-IN-PRODUCTION
AVS_PURGE_AFTER_HOURS=24

# Steps 12-21 — AI models, all off until their step lands
AVS_MODEL_DIR=models
AVS_ENABLE_AI_CLASSIFY=false
AVS_ENABLE_AI_QUALITY=false
AVS_ENABLE_AI_LOCALIZE=false
AVS_ENABLE_AI_RESTORE=false
AVS_ENABLE_AI_NAMEMATCH=false

# Local corpus for tests — never inside this repository
# AVS_CORPUS_DIR=/absolute/path/to/aadhaar-corpus
